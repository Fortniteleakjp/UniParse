<Window x:Class="UnityFModel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:ctrl="clr-namespace:UnityFModel.Controls"
        Title="UnityFModel — Unity アセットビューア" Height="760" Width="1240"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Drop="OnDrop" DragOver="OnDragOver">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button Content="📂 ファイルを開く" Command="{Binding OpenFileCommand}" Margin="0,0,6,0"/>
                    <Button Content="🗁 フォルダを開く" Command="{Binding OpenFolderCommand}" Margin="0,0,6,0"/>
                    <Button Content="✕ 閉じる" Command="{Binding CloseCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="クラス:" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" Margin="0,0,6,0"/>
                    <ComboBox Width="210" VerticalAlignment="Center"
                              ItemsSource="{Binding ClassOptions}"
                              SelectedItem="{Binding SelectedClassOption}"
                              DisplayMemberPath="Display"
                              ToolTip="表示するクラス（アセット種別）を選択"/>
                    <TextBox x:Name="SearchBox" Width="200" Margin="10,0,0,0" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnSearchKeyDown" ToolTip="名前でフィルタ (Enter で適用)"/>
                    <Button Content="🔍 検索" Command="{Binding ApplyFilterCommand}" Margin="6,0,0,0"/>
                    <Button Content="クリア" Command="{Binding ClearFilterCommand}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Main ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Structure tree -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource Panel2Brush}" Padding="10,6">
                        <TextBlock Text="ファイル構造" FontWeight="SemiBold"/>
                    </Border>
                    <!-- The default VirtualizingStackPanel has a measure re-entrancy bug that
                         stack-overflows with this data (it self-recurses even with IsVirtualizing
                         off). Replacing the items host with a plain StackPanel — at the root AND
                         inside every TreeViewItem — avoids that code path entirely. -->
                    <TreeView x:Name="Tree" ItemsSource="{Binding RootNodes}"
                              Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                              SelectedItemChanged="OnTreeSelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <TreeView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </TreeView.ItemsPanel>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                    <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" ResizeBehavior="PreviousAndNext"/>

            <!-- Detail -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Asset header + actions -->
                <Border Grid.Row="0" Background="{StaticResource Panel2Brush}" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding AssetHeader}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding AssetSubHeader}" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🖼 画像を保存" Command="{Binding SaveImageCommand}" Margin="0,0,6,0"
                                    Visibility="{Binding ShowImage, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="🧊 モデルを保存" Command="{Binding SaveModelCommand}" Margin="0,0,6,0"
                                    Visibility="{Binding ShowModel, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="🔊 音声を保存" Command="{Binding SaveAudioCommand}" Margin="0,0,6,0"
                                    Visibility="{Binding ShowAudio, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="🎬 動画を保存" Command="{Binding SaveVideoCommand}" Margin="0,0,6,0"
                                    Visibility="{Binding ShowVideo, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="🧾 JSON を保存" Command="{Binding SaveJsonCommand}" Margin="0,0,6,0"/>
                            <Button Content="📝 テキスト保存" Command="{Binding SaveTextCommand}"
                                    Visibility="{Binding HasTextContent, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Data (left: JSON / text / log)  +  Image preview (right) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1.1*" MinWidth="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- Data tabs -->
                    <TabControl Grid.Column="0" Background="{StaticResource BgBrush}" BorderThickness="0">
                        <TabItem Header="JSON">
                            <avalon:TextEditor x:Name="JsonEditor"
                                               IsReadOnly="True" ShowLineNumbers="True" WordWrap="False"
                                               FontFamily="Consolas" FontSize="12.5"
                                               Background="{StaticResource PanelBrush}" Foreground="#FFD4D4D4"
                                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                        </TabItem>
                        <TabItem Header="{Binding TextTabHeader}"
                                 Visibility="{Binding HasTextContent, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding TextContent, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="12.5" BorderThickness="0"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </TabItem>
                        <TabItem Header="ログ">
                            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="11.5" BorderThickness="0"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </TabItem>
                    </TabControl>

                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                  Background="{StaticResource BorderBrush}" ResizeBehavior="PreviousAndNext"/>

                    <!-- Preview (right of the JSON view): image / 3D model / audio — auto-fits the pane -->
                    <Border Grid.Column="2" Background="{StaticResource CheckerBrush}" ClipToBounds="True">
                        <Grid>
                            <!-- Image -->
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" Margin="12"
                                   Visibility="{Binding ShowImage, Converter={StaticResource BoolToVis}}"/>

                            <!-- 3D model -->
                            <ctrl:Model3DViewer Geometry="{Binding ModelGeometry}"
                                                Visibility="{Binding ShowModel, Converter={StaticResource BoolToVis}}"/>

                            <!-- Audio -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                                        Visibility="{Binding ShowAudio, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="🔊" FontSize="56" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding AudioInfo}" Foreground="{StaticResource TextBrush}"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Margin="0,12,0,0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <Button Content="▶ 再生" Command="{Binding PlayAudioCommand}" Margin="0,0,8,0"/>
                                    <Button Content="⏹ 停止" Command="{Binding StopAudioCommand}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Video -->
                            <Grid Visibility="{Binding ShowVideo, Converter={StaticResource BoolToVis}}">
                                <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                              Stretch="Uniform" ScrubbingEnabled="True"
                                              MediaFailed="OnVideoFailed" MediaEnded="OnVideoEnded"/>
                                <TextBlock Text="{Binding VideoError}" Foreground="#FFE57373"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" Margin="20"
                                           Visibility="{Binding HasVideoError, Converter={StaticResource BoolToVis}}"/>
                                <Border VerticalAlignment="Bottom" Background="#A0000000" Padding="8,6">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="▶ 再生" Click="OnVideoPlay" Margin="0,0,6,0"/>
                                        <Button Content="⏸ 一時停止" Click="OnVideoPause" Margin="0,0,6,0"/>
                                        <Button Content="⏹ 停止" Click="OnVideoStop" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding VideoInfo}" Foreground="White" VerticalAlignment="Center" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Message / placeholder -->
                            <TextBlock Text="{Binding PreviewMessage}" Foreground="{StaticResource SubTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Margin="20"
                                       Visibility="{Binding ShowMessage, Converter={StaticResource BoolToVis}}"/>

                            <!-- Info overlay (dimensions / vertex counts) -->
                            <Border Background="#99000000" CornerRadius="4" Padding="6,2" Margin="8"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Visibility="{Binding ShowInfoOverlay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding PreviewInfo}" Foreground="White" FontSize="11"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,4">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Unity: " Foreground="{StaticResource SubTextBrush}"/>
                    <TextBlock Text="{Binding ProjectVersion}" Margin="0,0,16,0"/>
                    <TextBlock Text="アセット数: " Foreground="{StaticResource SubTextBrush}"/>
                    <TextBlock Text="{Binding AssetCount, StringFormat=N0}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Busy overlay ===== -->
        <Grid Grid.RowSpan="3" Background="#CC1E1F22" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="24" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="⏳ 読み込み中..." FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource SubTextBrush}"
                               Margin="0,10,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,16,0,0" Width="400"
                                 Background="{StaticResource Panel2Brush}" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
